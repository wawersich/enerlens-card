{
  "name": "enerlens-card",
  "version": "1.0.0",
  "description": "EnerLens - energy flow card for Home Assistant (PV, battery, heat pump, grid)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.gui.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src test",
    "format": "biome check --write src test",
    "deploy": "./scripts/deploy.sh",
    "check": "./scripts/check.sh",
    "hero": "node scripts/hero.mjs",
    "editor-shot": "node scripts/editor-shot.mjs",
    "gui-test": "playwright test -c gui-test/playwright.config.ts",
    "doc-shots": "playwright test -c gui-test/shots.config.ts",
    "webkit-check": "node scripts/webkit-check.mjs",
    "leuchtspur": "./scripts/leuchtspur.sh",
    "site": "node asciidoc/build.mjs"
  },
  "dependencies": {
    "lit": "3.2.1"
  },
  "devDependencies": {
    "@asciidoctor/core": "3.0.4",
    "@biomejs/biome": "1.9.4",
    "@mdi/js": "7.4.47",
    "@playwright/test": "1.64.0",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.0",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "12.1.2",
    "@types/node": "22.13.1",
    "happy-dom": "16.8.1",
    "pagefind": "1.5.2",
    "rollup": "4.34.0",
    "tslib": "2.8.1",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}
