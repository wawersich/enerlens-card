exports[`rows without values stay as they were (LZ-2, LZ-14) > below the cross 1`] = `"<div class="list stacked" style="--el-row-h:40px"><p class="list-title">Verbraucher</p><div class="rows"><ha-icon class="origin-icon" aria-hidden="true" style="color:var(--primary-color)"></ha-icon><div class="charge row" data-key="sensor.wallbox"><span class="lane" aria-hidden="true"></span><span class="icon swatch" style="color:#7e57c2;--el-fill:0.0%" title="Ladestand 78 %"><svg viewBox="0 0 24 24" aria-hidden="true" class="charge-ring" style="color:#7e57c2"><circle class="track" cx="12" cy="12" r="11.2"></circle><circle class="fill" cx="12" cy="12" transform="rotate(-90 12 12)" r="11.2" stroke-dasharray="54.89 70.37"></circle></svg><ha-icon></ha-icon></span><span class="name">Wallbox</span><span class="row-value" title="">2,00 kW</span><button class="row-hit" title="" aria-label="Wallbox 2,00 kW, Ladestand 78 %"></button></div><div class="band bold row" style="--el-row-color:#26a69a" data-key="sensor.pump"><span class="lane" aria-hidden="true"></span><span class="dot swatch" style="color:#26a69a"></span><span class="name">Wärmepumpe</span><span class="row-value" title="">0,60 kW</span><button class="row-hit" title="" aria-label="Wärmepumpe 0,60 kW, sensor.ww 52 °C"></button><span class="bar top" style="--bar-color:#26a69a;--bar-fill:60.0%" title="sensor.ww 52 °C"></span></div><div class="rest row" data-key="__rest__"><span class="lane" aria-hidden="true"></span><span class="dot swatch" style="color:#7d7d7d"></span><span class="name">Rest</span><span class="row-value" title="">0,40 kW</span><button class="row-hit" title="" aria-label="Rest 0,40 kW"></button></div></div></div>"`;

exports[`rows without values stay as they were (LZ-2, LZ-14) > beside the cross 1`] = `"<div class="list" style="--el-row-h:40px"><p class="list-title">Verbraucher</p><div class="rows"><div class="charge row" data-key="sensor.wallbox"><span class="icon swatch" style="color:#7e57c2;--el-fill:0.0%" title="Ladestand 78 %"><svg viewBox="0 0 24 24" aria-hidden="true" class="charge-ring" style="color:#7e57c2"><circle class="track" cx="12" cy="12" r="11.2"></circle><circle class="fill" cx="12" cy="12" transform="rotate(-90 12 12)" r="11.2" stroke-dasharray="54.89 70.37"></circle></svg><ha-icon></ha-icon></span><span class="name">Wallbox</span><span class="row-value" title="">2,00 kW</span><button class="row-hit" title="" aria-label="Wallbox 2,00 kW, Ladestand 78 %"></button></div><div class="band bold row" style="--el-row-color:#26a69a" data-key="sensor.pump"><span class="dot swatch" style="color:#26a69a"></span><span class="name">Wärmepumpe</span><span class="row-value" title="">0,60 kW</span><button class="row-hit" title="" aria-label="Wärmepumpe 0,60 kW, sensor.ww 52 °C"></button><span class="bar top" style="--bar-color:#26a69a;--bar-fill:60.0%" title="sensor.ww 52 °C"></span></div><div class="rest row" data-key="__rest__"><span class="dot swatch" style="color:#7d7d7d"></span><span class="name">Rest</span><span class="row-value" title="">0,40 kW</span><button class="row-hit" title="" aria-label="Rest 0,40 kW"></button></div></div></div>"`;
